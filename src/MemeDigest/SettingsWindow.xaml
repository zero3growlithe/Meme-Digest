<Window x:Class="MemeDigest.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meme Digest — Settings"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF14141A"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB8B8C8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF20202A" />
            <Setter Property="Foreground" Value="#FFE8E8F0" />
            <Setter Property="BorderBrush" Value="#FF3C3C4E" />
            <Setter Property="CaretBrush" Value="#FFE8E8F0" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A36" />
            <Setter Property="Foreground" Value="#FFE8E8F0" />
            <Setter Property="BorderBrush" Value="#FF3C3C4E" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock Text="Meme library root (subfolders are scanned recursively)" Foreground="#FF8A8AA0" FontSize="12" Margin="0,0,0,4" />
        <DockPanel>
            <Button x:Name="BrowseLibraryButton" DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0" Style="{StaticResource DialogButtonStyle}" Click="BrowseLibraryButton_Click" />
            <TextBox x:Name="LibraryPathBox" />
        </DockPanel>

        <TextBlock Text="History folder (human-readable per-user .txt files)" Foreground="#FF8A8AA0" FontSize="12" Margin="0,14,0,4" />
        <DockPanel>
            <Button x:Name="BrowseHistoryButton" DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0" Style="{StaticResource DialogButtonStyle}" Click="BrowseHistoryButton_Click" />
            <TextBox x:Name="HistoryDirectoryBox" />
        </DockPanel>

        <TextBlock Text="Thumbnail cache folder (video posters generated via ffmpeg)" Foreground="#FF8A8AA0" FontSize="12" Margin="0,14,0,4" />
        <DockPanel>
            <Button x:Name="BrowseThumbnailsButton" DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0" Style="{StaticResource DialogButtonStyle}" Click="BrowseThumbnailsButton_Click" />
            <TextBox x:Name="ThumbnailDirectoryBox" />
        </DockPanel>

        <TextBlock Text="ffmpeg executable (used only for video previews — optional, e.g. C:\tools\ffmpeg\bin\ffmpeg.exe)" Foreground="#FF8A8AA0" FontSize="12" Margin="0,14,0,4" />
        <DockPanel>
            <Button x:Name="BrowseFfmpegButton" DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0" Style="{StaticResource DialogButtonStyle}" Click="BrowseFfmpegButton_Click" />
            <TextBox x:Name="FfmpegPathBox" />
        </DockPanel>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Memes per draw:" Margin="0,0,8,0" />
            <TextBox x:Name="DrawCountBox" Grid.Column="1" Width="60" HorizontalAlignment="Left" />
            <TextBlock Grid.Column="2" Text="Max selection:" Margin="18,0,8,0" />
            <TextBox x:Name="MaxSelectionBox" Grid.Column="3" Width="60" HorizontalAlignment="Left" />
        </Grid>

        <TextBlock Text="Image extensions (comma separated)" Foreground="#FF8A8AA0" FontSize="12" Margin="0,14,0,4" />
        <TextBox x:Name="ImageExtensionsBox" />

        <TextBlock Text="Video extensions (comma separated)" Foreground="#FF8A8AA0" FontSize="12" Margin="0,14,0,4" />
        <TextBox x:Name="VideoExtensionsBox" />

        <WrapPanel HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="OK" Style="{StaticResource DialogButtonStyle}" IsDefault="True" Click="OkButton_Click" />
            <Button Content="Cancel" Style="{StaticResource DialogButtonStyle}" IsCancel="True" />
        </WrapPanel>
    </StackPanel>
</Window>