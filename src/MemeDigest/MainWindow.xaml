<Window x:Class="MemeDigest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meme Digest"
        Width="1180"
        Height="740"
        MinWidth="780"
        MinHeight="520"
        Background="#FF14141A"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="ToolBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A36" />
            <Setter Property="Foreground" Value="#FFE8E8F0" />
            <Setter Property="BorderBrush" Value="#FF3C3C4E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF3A3A4C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolBarTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB8B8C8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,6,0" />
        </Style>
        <Style x:Key="ComboBoxItemDarkStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFE8E8F0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF3A3A4C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF44445A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF2A2A36" />
            <Setter Property="Foreground" Value="#FFE8E8F0" />
            <Setter Property="BorderBrush" Value="#FF3C3C4E" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemDarkStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ChromeBorder" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="4">
                                            <Path HorizontalAlignment="Right" Margin="10,0,10,0" VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FFB8B8C8" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ChromeBorder" Property="Background" Value="#FF3A3A4C" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,30,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#FF20202A" BorderBrush="#FF3C3C4E" BorderThickness="1" CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320" Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FF20202A" />
            <Setter Property="Foreground" Value="#FFE8E8F0" />
            <Setter Property="BorderBrush" Value="#FF3C3C4E" />
            <Setter Property="CaretBrush" Value="#FFE8E8F0" />
        </Style>
        <Style x:Key="DarkTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FF9A9AB0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" BorderBrush="#FF3C3C4E" BorderThickness="1,1,1,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF2E2E3C" />
                                <Setter Property="Foreground" Value="#FFE8E8F0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF28283A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ── Toolbar ── -->
        <Border DockPanel.Dock="Top" Background="#FF1C1C24" Padding="12,8" BorderBrush="#FF26262E" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBlock Text="Profile:" Style="{StaticResource ToolBarTextStyle}" />
                <ComboBox x:Name="ProfileComboBox" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="ProfileComboBox_SelectionChanged" />
                <Button x:Name="AddProfileButton" Content="Add profile" Style="{StaticResource ToolBarButtonStyle}" Click="AddProfileButton_Click" />
                <Button x:Name="RemoveProfileButton" Content="Remove" Style="{StaticResource ToolBarButtonStyle}" Click="RemoveProfileButton_Click" />

                <Separator Width="18" Background="Transparent" />

                <TextBlock Text="Draw count:" Style="{StaticResource ToolBarTextStyle}" />
                <TextBox x:Name="DrawCountBox" Width="44" Style="{StaticResource DarkTextBoxStyle}" TextAlignment="Center" VerticalContentAlignment="Center" Text="12" />
                <Button x:Name="DrawButton" Content="Draw memes" Style="{StaticResource ToolBarButtonStyle}" Click="DrawButton_Click" />

                <Separator Width="18" Background="Transparent" />

                <Button x:Name="SettingsButton" Content="Settings" Style="{StaticResource ToolBarButtonStyle}" Click="SettingsButton_Click" />
            </WrapPanel>
        </Border>

        <!-- ── Tab bar ── -->
        <Border DockPanel.Dock="Top" Background="#FF22222C" Padding="12,4" BorderBrush="#FF26262E" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="DrawerTabButton" Content="Meme Drawer" GroupName="MainTabs" Style="{StaticResource DarkTabStyle}" Checked="DrawerTabButton_Checked" IsChecked="True" />
                <RadioButton x:Name="KeptTabButton" Content="Kept Memes" GroupName="MainTabs" Style="{StaticResource DarkTabStyle}" Checked="KeptTabButton_Checked" />
                <RadioButton x:Name="DiscardedTabButton" Content="Discarded Memes" GroupName="MainTabs" Style="{StaticResource DarkTabStyle}" Checked="DiscardedTabButton_Checked" />
                <Button x:Name="ResetSelectedButton" Content="♻ Reset selected" Style="{StaticResource ToolBarButtonStyle}" Margin="16,0,0,0" Click="ResetSelectedButton_Click" ToolTip="Remove the selected memes from history so they can be drawn again" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- ── Export toolbar ── -->
        <Border DockPanel.Dock="Top" Background="#FF18181F" Padding="12,6" BorderBrush="#FF26262E" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBlock Text="Selected:" Style="{StaticResource ToolBarTextStyle}" />
                <Button x:Name="SelectAllButton" Content="☑ Select all" Style="{StaticResource ToolBarButtonStyle}" Click="SelectAllButton_Click" />
                <Button x:Name="DeselectAllButton" Content="☐ Deselect all" Style="{StaticResource ToolBarButtonStyle}" Click="DeselectAllButton_Click" />
                <Button x:Name="KeepAllButton" Content="❤ Keep all selected" Style="{StaticResource ToolBarButtonStyle}" Click="KeepAllButton_Click" />
                <Button x:Name="DiscardAllButton" Content="✕ Discard all selected" Style="{StaticResource ToolBarButtonStyle}" Click="DiscardAllButton_Click" />
                <Button x:Name="RevealSelectedButton" Content="Reveal in folders" Style="{StaticResource ToolBarButtonStyle}" Click="RevealSelectedButton_Click" />
                <Button x:Name="CopySelectedButton" Content="Copy files to clipboard" Style="{StaticResource ToolBarButtonStyle}" Click="CopySelectedButton_Click" />
                <Button x:Name="MoveSelectedButton" Content="Move…" Style="{StaticResource ToolBarButtonStyle}" Click="MoveSelectedButton_Click" />
                <Button x:Name="CopyToFolderButton" Content="Copy to folder…" Style="{StaticResource ToolBarButtonStyle}" Click="CopyToFolderButton_Click" />
            </WrapPanel>
        </Border>

        <!-- ── Status bar ── -->
        <Border DockPanel.Dock="Bottom" Background="#FF1C1C24" Padding="12,6" BorderBrush="#FF26262E" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="StatusLeftTextBlock" DockPanel.Dock="Left" Foreground="#FF8A8AA0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusRightTextBlock" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#FF8A8AA0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ── Content ── -->
        <Grid>
            <ScrollViewer x:Name="DrawerTabContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="GalleryHeaderTextBlock" Foreground="#FFB8B8C8" FontSize="14" Margin="14,10,14,0" />
                    <WrapPanel x:Name="GalleryPanel" Margin="6,6,6,18" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="KeptPanelHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="KeptHeaderTextBlock" Foreground="#FFB8B8C8" FontSize="14" Margin="14,10,14,0" />
                    <WrapPanel x:Name="KeptPanel" Margin="6,6,6,18" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DiscardedPanelHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="DiscardedHeaderTextBlock" Foreground="#FFB8B8C8" FontSize="14" Margin="14,10,14,0" />
                    <WrapPanel x:Name="DiscardedPanel" Margin="6,6,6,18" />
                </StackPanel>
            </ScrollViewer>

            <!-- ── Full-window viewer overlay ── -->
            <Border x:Name="ViewerOverlay" Background="#F5101016" Visibility="Collapsed" Focusable="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,12,12,4" Background="Transparent" MouseLeftButtonDown="ViewerBackdrop_MouseLeftButtonDown">
                        <Image x:Name="ViewerImage" Stretch="Uniform" StretchDirection="DownOnly" Visibility="Collapsed" MouseDown="ViewerSurface_MouseDown" />
                        <MediaElement x:Name="ViewerVideo" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform" Visibility="Collapsed" MediaFailed="ViewerVideo_MediaFailed" MediaOpened="ViewerVideo_MediaOpened" MediaEnded="ViewerVideo_MediaEnded" MouseDown="ViewerSurface_MouseDown" />
                        <TextBlock x:Name="ViewerMediaErrorTextBlock" Foreground="#FFC06060" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
                    </Grid>

                    <Border Grid.Row="1" Background="#FF1C1C24" Padding="12,8" BorderBrush="#FF26262E" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="◀ Prev" Style="{StaticResource ToolBarButtonStyle}" Click="ViewerPrevButton_Click" />
                                <Button x:Name="ViewerKeepButton" Content="❤ Keep" Style="{StaticResource ToolBarButtonStyle}" Click="ViewerKeepButton_Click" />
                                <Button x:Name="ViewerDiscardButton" Content="✕ Discard" Style="{StaticResource ToolBarButtonStyle}" Click="ViewerDiscardButton_Click" />
                                <Button Content="Next ▶" Style="{StaticResource ToolBarButtonStyle}" Click="ViewerNextButton_Click" />
                                <Rectangle Width="1" Margin="8,2" Fill="#FF3C3C4E" />
                                <Button x:Name="ViewerPlayPauseButton" Content="⏸ Pause" Style="{StaticResource ToolBarButtonStyle}" Click="ViewerPlayPauseButton_Click" />
                                <TextBlock x:Name="ViewerTimeTextBlock" Foreground="#FF8A8AA0" VerticalAlignment="Center" Margin="8,0,8,0" Text="00:00 / 00:00" />
                                <Slider x:Name="ViewerSeekSlider" Width="220" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" Thumb.DragStarted="ViewerSeekSlider_DragStarted" Thumb.DragCompleted="ViewerSeekSlider_DragCompleted" ValueChanged="ViewerSeekSlider_ValueChanged" />
                                <Button x:Name="ViewerMuteButton" Content="🔊" Style="{StaticResource ToolBarButtonStyle}" Click="ViewerMuteButton_Click" />
                                <Slider x:Name="ViewerVolumeSlider" Width="100" Minimum="0" Maximum="1" Value="0" ValueChanged="ViewerVolumeSlider_ValueChanged" ToolTip="Volume — audio plays muted at start, drag up to hear it" />
                            </StackPanel>
                            <TextBlock x:Name="ViewerCaptionTextBlock" Foreground="#FFB8B8C8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="ViewerCopyButton" Content="⧉ Copy" Style="{StaticResource ToolBarButtonStyle}" Click="ViewerCopyButton_Click" ToolTip="Copy the file to the clipboard (Ctrl+C in viewer) — paste into Discord or Explorer" />
                                <Button x:Name="ViewerRevealButton" Content="📁 Select in Explorer" Style="{StaticResource ToolBarButtonStyle}" Click="ViewerRevealButton_Click" ToolTip="Open the file's folder and select the file" />
                                <Button Content="Close (Esc)" Style="{StaticResource ToolBarButtonStyle}" Click="ViewerCloseButton_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>