<Window x:Class="MemeDigest.ProfileNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New profile"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF14141A">
    <StackPanel Margin="18">
        <TextBlock Text="Profile name:" Foreground="#FFB8B8C8" Margin="0,0,0,6" />
        <TextBox x:Name="ProfileNameBox" Padding="4,4" Background="#FF20202A" Foreground="#FFE8E8F0" BorderBrush="#FF3C3C4E" CaretBrush="#FFE8E8F0" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" IsDefault="True" Background="#FF2A2A36" Foreground="#FFE8E8F0" BorderBrush="#FF3C3C4E" Padding="10,5" Margin="6,0,0,0" Click="OkButton_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" Background="#FF2A2A36" Foreground="#FFE8E8F0" BorderBrush="#FF3C3C4E" Padding="10,5" Margin="6,0,0,0" />
        </WrapPanel>
    </StackPanel>
</Window>